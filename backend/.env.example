# ---------- Server ----------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://postgres:password@localhost:5432/submission_dashboard"

# ---------- JWT ----------
# Use long random strings, and make the two secrets different from each other
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES=7d

# ---------- Password hashing ----------
BCRYPT_SALT_ROUND=10

# ---------- Seeded mentor (created automatically on server start) ----------
ADMIN_EMAIL=mentor@example.com
ADMIN_PASSWORD=Mentor@12345
